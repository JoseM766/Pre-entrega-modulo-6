# Variables del entorno de TESTING. Copiá este archivo como ".env.test" y completalo.
# El archivo ".env.test" NO se sube al repositorio.
#
# IMPORTANTE: usá una base de datos SEPARADA y descartable (el nombre debe contener "test").
# Los tests borran los datos de esa base: NUNCA apuntes a tu base de desarrollo.

NODE_ENV=test
PORT=8081
MONGODB_URI=mongodb://127.0.0.1:27017/shipnow_test
JWT_SECRET=test_secret
